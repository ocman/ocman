{
  "uid": "ocman-overview",
  "title": "ocman Overview",
  "description": "Single-pane view of ocman's business stats, HTTP, DB, background, and runtime metrics, plus recent traces.",
  "tags": ["ocman"],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "time": { "from": "now-30m", "to": "now" },
  "refresh": "30s",
  "timepicker": {},
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": { "qryType": 1, "query": "label_values(http_server_request_duration_seconds_count, service_name)", "refId": "service" },
        "current": { "text": "ocman", "value": "ocman" },
        "includeAll": false,
        "multi": false,
        "refresh": 1,
        "sort": 1
      },
      {
        "name": "route",
        "label": "Route",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": { "qryType": 1, "query": "label_values(http_server_request_duration_seconds_count{service_name=\"$service\"}, http_route)", "refId": "route" },
        "current": { "text": "All", "value": "$__all" },
        "includeAll": true,
        "multi": true,
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "ocman errors",
        "datasource": { "type": "loki", "uid": "loki" },
        "enable": true,
        "iconColor": "red",
        "expr": "{service_name=\"$service\"} |= \"level=error\"",
        "titleFormat": "error",
        "tagKeys": "level"
      }
    ]
  },
  "panels": [
    { "type": "row", "title": "Overview", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }, "collapsed": false, "panels": [] },
    {
      "type": "stat",
      "title": "Request rate",
      "description": "API requests/sec across all routes.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 4, "x": 0, "y": 1 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_request_duration_seconds_count{service_name=\"$service\"}[5m]))",
          "legendFormat": "req/s"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "decimals": 2, "color": { "mode": "thresholds" } } },
      "options": { "colorMode": "value", "graphMode": "area", "textMode": "auto", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "stat",
      "title": "p95 latency",
      "description": "95th-percentile API latency, all routes.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 4, "x": 4, "y": 1 },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_seconds_bucket{service_name=\"$service\"}[5m])))",
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "green" },
              { "value": 0.25, "color": "yellow" },
              { "value": 1, "color": "red" }
            ]
          }
        }
      },
      "options": { "colorMode": "value", "graphMode": "area", "textMode": "auto", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "stat",
      "title": "Error rate (5xx)",
      "description": "Share of 5xx responses over the last 5 minutes.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 4, "x": 8, "y": 1 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_request_duration_seconds_count{service_name=\"$service\",http_response_status_code=~\"5..\"}[5m])) / clamp_min(sum(rate(http_server_request_duration_seconds_count{service_name=\"$service\"}[5m])), 1)",
          "legendFormat": "5xx"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "green" },
              { "value": 0.01, "color": "yellow" },
              { "value": 0.05, "color": "red" }
            ]
          }
        }
      },
      "options": { "colorMode": "value", "graphMode": "area", "textMode": "auto", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "stat",
      "title": "Active SSE",
      "description": "Live ocman SSE event-stream connections.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 4, "x": 12, "y": 1 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(ocman_sse_active_connections{service_name=\"$service\"}) or vector(0)",
          "legendFormat": "active"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "color": { "mode": "thresholds" } } },
      "options": { "colorMode": "value", "graphMode": "area", "textMode": "auto", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "stat",
      "title": "Goroutines",
      "description": "Live Go goroutines.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 4, "x": 16, "y": 1 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(go_goroutine_count{service_name=\"$service\"})",
          "legendFormat": "goroutines"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 } },
      "options": { "colorMode": "value", "graphMode": "area", "textMode": "auto", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "stat",
      "title": "Memory in use",
      "description": "Heap memory currently in use by the Go runtime.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 4, "x": 20, "y": 1 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(go_memory_used_bytes{service_name=\"$service\"})",
          "legendFormat": "heap"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "decbytes", "decimals": 1 } },
      "options": { "colorMode": "value", "graphMode": "area", "textMode": "auto", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },

    { "type": "row", "title": "Business Stats", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 6 }, "collapsed": false, "panels": [] },
    {
      "type": "stat",
      "title": "Sessions",
      "description": "Total number of coding sessions.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 7 },
      "targets": [{ "refId": "A", "expr": "ocman_stats_sessions{service_name=\"$service\"}", "legendFormat": "sessions" }],
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 } },
      "options": { "colorMode": "value", "graphMode": "area", "textMode": "auto", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "stat",
      "title": "User Messages",
      "description": "Total user prompts sent across all sessions.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 7 },
      "targets": [{ "refId": "A", "expr": "ocman_stats_messages{service_name=\"$service\"}", "legendFormat": "messages" }],
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 } },
      "options": { "colorMode": "value", "graphMode": "area", "textMode": "auto", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "stat",
      "title": "Projects",
      "description": "Distinct project directories.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 7 },
      "targets": [{ "refId": "A", "expr": "ocman_stats_projects{service_name=\"$service\"}", "legendFormat": "projects" }],
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 } },
      "options": { "colorMode": "value", "graphMode": "area", "textMode": "auto", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "stat",
      "title": "Input Tokens",
      "description": "Lifetime input tokens across all sessions.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 7 },
      "targets": [{ "refId": "A", "expr": "ocman_stats_tokens_input{service_name=\"$service\"}", "legendFormat": "input" }],
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 } },
      "options": { "colorMode": "value", "graphMode": "area", "textMode": "auto", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "stat",
      "title": "Output Tokens",
      "description": "Lifetime output tokens across all sessions.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 7 },
      "targets": [{ "refId": "A", "expr": "ocman_stats_tokens_output{service_name=\"$service\"}", "legendFormat": "output" }],
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 } },
      "options": { "colorMode": "value", "graphMode": "area", "textMode": "auto", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "stat",
      "title": "Total Cost",
      "description": "Lifetime API cost across all sessions.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 7 },
      "targets": [{ "refId": "A", "expr": "ocman_stats_cost{service_name=\"$service\"}", "legendFormat": "cost" }],
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 2 } },
      "options": { "colorMode": "value", "graphMode": "area", "textMode": "auto", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "timeseries",
      "title": "User messages over time",
      "description": "Rate of new user prompts. Derived from the ocman.stats.messages gauge (increase per collection interval).",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 11 },
      "targets": [
        {
          "refId": "A",
          "expr": "increase(ocman_stats_messages{service_name=\"$service\"}[5m])",
          "legendFormat": "user messages / 5m"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 1, "custom": { "drawStyle": "bars", "fillOpacity": 60 } } },
      "options": { "legend": { "showLegend": false } }
    },

    {
      "type": "timeseries",
      "title": "Token usage over time",
      "description": "Input, output, and cache-read tokens per 5-minute window, broken down by type.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 18 },
      "targets": [
        { "refId": "A", "expr": "sum(rate(ocman_llm_tokens_input_total{service_name=\"$service\"}[5m]))", "legendFormat": "Input" },
        { "refId": "B", "expr": "sum(rate(ocman_llm_tokens_cache_read_total{service_name=\"$service\"}[5m]))", "legendFormat": "Cache Read" },
        { "refId": "C", "expr": "sum(rate(ocman_llm_tokens_output_total{service_name=\"$service\"}[5m]))", "legendFormat": "Output" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "drawStyle": "bars", "fillOpacity": 60, "stacking": { "mode": "normal" } } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Input" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#89b4fa" } }] },
          { "matcher": { "id": "byName", "options": "Cache Read" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#a6e3a1" } }] },
          { "matcher": { "id": "byName", "options": "Output" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#cba6f7" } }] }
        ]
      },
      "options": { "legend": { "showLegend": true, "displayMode": "list", "placement": "bottom" } }
    },
    {
      "type": "timeseries",
      "title": "Cost over time",
      "description": "LLM API cost rate (USD per 5-minute window).",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 18 },
      "targets": [
        { "refId": "A", "expr": "sum(rate(ocman_llm_cost_total{service_name=\"$service\"}[5m]))", "legendFormat": "cost/5m" }
      ],
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 4, "custom": { "drawStyle": "line", "fillOpacity": 20 } } },
      "options": { "legend": { "showLegend": false } }
    },
    {
      "type": "timeseries",
      "title": "LLM request duration p50 / p95",
      "description": "Wall-clock time from request to completion for LLM turns.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 25 },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.5, sum by (le) (rate(ocman_llm_request_duration_seconds_bucket{service_name=\"$service\"}[5m])))", "legendFormat": "p50" },
        { "refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(ocman_llm_request_duration_seconds_bucket{service_name=\"$service\"}[5m])))", "legendFormat": "p95" }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "decimals": 2, "custom": { "drawStyle": "line", "fillOpacity": 10 } } },
      "options": { "legend": { "showLegend": true, "displayMode": "list", "placement": "bottom" } }
    },
    {
      "type": "timeseries",
      "title": "LLM requests by model",
      "description": "LLM turn rate broken down by model.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 25 },
      "targets": [
        { "refId": "A", "expr": "sum by (model) (rate(ocman_llm_requests_total{service_name=\"$service\"}[5m]))", "legendFormat": "{{model}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "bars", "fillOpacity": 60, "stacking": { "mode": "normal" } } } },
      "options": { "legend": { "showLegend": true, "displayMode": "list", "placement": "bottom" } }
    },
    {
      "type": "timeseries",
      "title": "Cache efficiency",
      "description": "Ratio of cache-read tokens to total cache tokens (read + write). Higher is better.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 32 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(ocman_llm_tokens_cache_read_total{service_name=\"$service\"}[5m])) / clamp_min(sum(rate(ocman_llm_tokens_cache_read_total{service_name=\"$service\"}[5m])) + sum(rate(ocman_llm_tokens_cache_write_total{service_name=\"$service\"}[5m])), 1) * 100",
          "legendFormat": "cache hit %"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "decimals": 1, "min": 0, "max": 100, "custom": { "drawStyle": "line", "fillOpacity": 15 } } },
      "options": { "legend": { "showLegend": false } }
    },
    {
      "type": "piechart",
      "title": "Stop reason distribution",
      "description": "Distribution of LLM turn stop reasons over the dashboard time range.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 32 },
      "targets": [
        { "refId": "A", "expr": "sum by (stop_reason) (increase(ocman_llm_requests_total{service_name=\"$service\"}[$__range]))", "legendFormat": "{{stop_reason}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } },
      "options": { "legend": { "showLegend": true, "displayMode": "list", "placement": "right" }, "pieType": "donut", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },

    { "type": "row", "title": "HTTP", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 39 }, "collapsed": false, "panels": [] },
    {
      "type": "timeseries",
      "title": "Request rate by route",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 40 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (http_route) (rate(http_server_request_duration_seconds_count{service_name=\"$service\",http_route=~\"$route\"}[5m]))",
          "legendFormat": "{{http_route}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "fillOpacity": 10 } } },
      "options": { "legend": { "showLegend": true, "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] } }
    },
    {
      "type": "timeseries",
      "title": "p95 latency by route",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 40 },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, http_route) (rate(http_server_request_duration_seconds_bucket{service_name=\"$service\",http_route=~\"$route\"}[5m])))",
          "legendFormat": "{{http_route}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "decimals": 3, "custom": { "drawStyle": "line", "fillOpacity": 5 } } },
      "options": { "legend": { "showLegend": true, "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] } }
    },
    {
      "type": "timeseries",
      "title": "Status code mix",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 48 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (http_response_status_code) (rate(http_server_request_duration_seconds_count{service_name=\"$service\",http_route=~\"$route\"}[5m]))",
          "legendFormat": "{{http_response_status_code}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "drawStyle": "bars", "fillOpacity": 80, "stacking": { "mode": "normal" } }
        },
        "overrides": [
          { "matcher": { "id": "byRegexp", "options": "^2..$" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }] },
          { "matcher": { "id": "byRegexp", "options": "^3..$" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } }] },
          { "matcher": { "id": "byRegexp", "options": "^4..$" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "yellow" } }] },
          { "matcher": { "id": "byRegexp", "options": "^5..$" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] }
        ]
      },
      "options": { "legend": { "showLegend": true, "displayMode": "list", "placement": "bottom" } }
    },
    {
      "type": "timeseries",
      "title": "Outbound HTTP latency p95",
      "description": "p95 of outgoing HTTP calls (OpenCode upstream + LiteLLM pricing).",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 48 },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, server_address) (rate(http_client_request_duration_seconds_bucket{service_name=\"$service\"}[5m])))",
          "legendFormat": "{{server_address}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "decimals": 3, "custom": { "drawStyle": "line", "fillOpacity": 10 } } },
      "options": { "legend": { "showLegend": true, "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] } }
    },

    { "type": "row", "title": "Database", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 56 }, "collapsed": false, "panels": [] },
    {
      "type": "timeseries",
      "title": "Query rate by database",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 57 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (db_name, method) (rate(db_sql_latency_milliseconds_count{service_name=\"$service\"}[5m]))",
          "legendFormat": "{{db_name}} / {{method}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "drawStyle": "line", "fillOpacity": 10 } } },
      "options": { "legend": { "showLegend": true, "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] } }
    },
    {
      "type": "timeseries",
      "title": "Query latency p95 by database",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 57 },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, db_name) (rate(db_sql_latency_milliseconds_bucket{service_name=\"$service\"}[5m])))",
          "legendFormat": "{{db_name}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ms", "decimals": 2, "custom": { "drawStyle": "line", "fillOpacity": 10 } } },
      "options": { "legend": { "showLegend": true, "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] } }
    },
    {
      "type": "timeseries",
      "title": "Open connections",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 65 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (db_name) (db_sql_connection_open{service_name=\"$service\"})",
          "legendFormat": "{{db_name}} open"
        },
        {
          "refId": "B",
          "expr": "sum by (db_name) (db_sql_connection_max_open{service_name=\"$service\"})",
          "legendFormat": "{{db_name}} max"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "custom": { "drawStyle": "line", "fillOpacity": 5 } } }
    },
    {
      "type": "timeseries",
      "title": "Connection wait time",
      "description": "Total time clients spent waiting for a free pool slot.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 65 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (db_name) (rate(db_sql_connection_wait_duration_milliseconds_total{service_name=\"$service\"}[5m]))",
          "legendFormat": "{{db_name}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ms", "custom": { "drawStyle": "line", "fillOpacity": 10 } } }
    },

    { "type": "row", "title": "Background work", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 72 }, "collapsed": false, "panels": [] },
    {
      "type": "timeseries",
      "title": "Auto-archive sessions/run",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 73 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (platform) (increase(ocman_auto_archive_sessions_total{service_name=\"$service\"}[1h]))",
          "legendFormat": "{{platform}} (1h sum)"
        },
        {
          "refId": "B",
          "expr": "sum(increase(ocman_auto_archive_runs_total{service_name=\"$service\"}[1h]))",
          "legendFormat": "runs (1h sum)"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "bars", "fillOpacity": 60 } } }
    },
    {
      "type": "timeseries",
      "title": "Projects-index refresh latency",
      "description": "p50/p95 of the periodic projects index rebuild.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 73 },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(ocman_projects_index_refresh_duration_milliseconds_bucket{service_name=\"$service\"}[15m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(ocman_projects_index_refresh_duration_milliseconds_bucket{service_name=\"$service\"}[15m])))",
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ms", "decimals": 2, "custom": { "drawStyle": "line", "fillOpacity": 10 } } }
    },

    { "type": "row", "title": "Runtime", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 80 }, "collapsed": false, "panels": [] },
    {
      "type": "timeseries",
      "title": "Memory",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 81 },
      "targets": [
        { "refId": "A", "expr": "go_memory_used_bytes{service_name=\"$service\"}", "legendFormat": "in use" },
        { "refId": "B", "expr": "go_memory_gc_goal_bytes{service_name=\"$service\"}", "legendFormat": "GC goal" }
      ],
      "fieldConfig": { "defaults": { "unit": "decbytes", "custom": { "drawStyle": "line", "fillOpacity": 10 } } }
    },
    {
      "type": "timeseries",
      "title": "Allocations",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 81 },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(go_memory_allocated_bytes_total{service_name=\"$service\"}[5m])",
          "legendFormat": "alloc bytes/s"
        },
        {
          "refId": "B",
          "expr": "rate(go_memory_allocations_total{service_name=\"$service\"}[5m])",
          "legendFormat": "allocs/s"
        }
      ],
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 10 } } }
    },

    { "type": "row", "title": "Traces", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 88 }, "collapsed": false, "panels": [] },
    {
      "type": "table",
      "title": "Recent traces",
      "description": "Recent ocman traces. Click a Trace ID to drill into Tempo.",
      "datasource": { "type": "tempo", "uid": "tempo" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 89 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "tempo", "uid": "tempo" },
          "queryType": "traceql",
          "query": "{resource.service.name=\"$service\"}",
          "limit": 50,
          "tableType": "traces"
        }
      ],
      "options": { "showHeader": true }
    },
    {
      "type": "table",
      "title": "Slow API calls (>500ms)",
      "description": "Recent ocman traces with span duration over 500ms.",
      "datasource": { "type": "tempo", "uid": "tempo" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 99 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "tempo", "uid": "tempo" },
          "queryType": "traceql",
          "query": "{resource.service.name=\"$service\" && span.duration > 500ms}",
          "limit": 50,
          "tableType": "traces"
        }
      ],
      "options": { "showHeader": true }
    },
    {
      "type": "table",
      "title": "Trace errors",
      "description": "Recent ocman traces containing at least one span with status=error.",
      "datasource": { "type": "tempo", "uid": "tempo" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 109 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "tempo", "uid": "tempo" },
          "queryType": "traceql",
          "query": "{resource.service.name=\"$service\" && status=error}",
          "limit": 50,
          "tableType": "traces"
        }
      ],
      "options": { "showHeader": true }
    },
    {
      "type": "table",
      "title": "Slowest phases",
      "description": "Internal phases (srvtiming spans) ranked by duration. Use to find which phase under a slow request is the bottleneck (e.g. lsof_miss, http_messages, db_get_sessions).",
      "datasource": { "type": "tempo", "uid": "tempo" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 119 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "tempo", "uid": "tempo" },
          "queryType": "traceql",
          "query": "{resource.service.name=\"$service\" && name=~\"phase:.*\" && span.duration > 50ms} | select(span.duration, name)",
          "limit": 100,
          "tableType": "spans"
        }
      ],
      "options": { "showHeader": true }
    },

    { "type": "row", "title": "Logs", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 129 }, "collapsed": true, "panels": [
      {
        "type": "logs",
        "title": "Errors and warnings",
        "datasource": { "type": "loki", "uid": "loki" },
        "gridPos": { "h": 12, "w": 24, "x": 0, "y": 130 },
        "targets": [
          {
            "refId": "A",
            "datasource": { "type": "loki", "uid": "loki" },
            "expr": "{service_name=\"$service\"} |~ \"level=(error|warning|warn)\""
          }
        ],
        "options": { "showTime": true, "wrapLogMessage": true, "sortOrder": "Descending", "dedupStrategy": "none", "enableLogDetails": true }
      }
    ] }
  ]
}
