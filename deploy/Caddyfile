# HTTPS proxy for ocman via Tailscale.
#
# Caddy fetches a Let's Encrypt certificate for your Tailscale hostname using
# `tailscale cert`. The cert is trusted by all devices on your tailnet without
# any manual CA installation.
#
# Prerequisites:
#   brew install caddy
#   export OCMAN_CADDY_HOST=my-machine.tailnet.ts.net   # your Tailscale hostname
#   make caddy-cert                                     # pre-fetch the cert (optional)
#
# Usage:
#   make caddy-up           # start (background)
#   make caddy-down         # stop
#
# Then open https://$OCMAN_CADDY_HOST on your other device
# (must be connected to Tailscale).

{$OCMAN_CADDY_HOST:localhost} {
	# Relay routes need HTTPS: the share viewer decrypts with WebCrypto,
	# which browsers disable for non-localhost HTTP origins.
	handle /s {
		reverse_proxy localhost:8231
	}

	handle /s/* {
		reverse_proxy localhost:8231
	}

	handle /v/* {
		reverse_proxy localhost:8231
	}

	handle {
		reverse_proxy localhost:8228
	}

	tls {
		get_certificate tailscale
	}
}
