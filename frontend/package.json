{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.11.1",
  "scripts": {
    "dev": "vite",
    "build": "pnpm generate:a2ui && tsc -b && vite build",
    "generate:a2ui": "node scripts/generate-a2ui.mjs",
    "lint": "node scripts/generate-a2ui.mjs --check && eslint . && pnpm lint:css",
    "lint:css": "stylelint \"src/**/*.css\"",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "perf": "OCMAN_PROFILE=1 vite build --outDir perf/dist && playwright test -c playwright.perf.config.ts"
  },
  "dependencies": {
    "@assistant-ui/react": "^0.15.28",
    "@dagrejs/dagre": "^3.1.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@lobehub/icons-static-svg": "^1.95.1",
    "@pierre/diffs": "^1.5.2",
    "@pierre/trees": "1.0.0-beta.6",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toast": "^1.3.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tanstack/react-query": "^5.104.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "ajv": "^8.20.0",
    "bootstrap-icons": "^1.13.2",
    "chart.js": "^4.5.1",
    "highlight.js": "^11.12.0",
    "mermaid": "^11.17.2",
    "react": "^19.3.0",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "react-zoom-pan-pinch": "^4.2.0",
    "rehype-highlight": "^7.0.2",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "7.29.6",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.0",
    "@rolldown/plugin-babel": "^0.2.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^4.1.11",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "overrides": {
      "js-yaml": "4.3.2",
      "undici": "7.30.0"
    }
  }
}
