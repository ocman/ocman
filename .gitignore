/ocman
node_modules/
tmp/
dist/
# Build cache and artifacts
.cache/
ocman-desktop
.env
# Coverage output (CI ratchet, spec/ci-coverage-ratchet). Baselines
# live on the gh-pages branch, never on main.
coverage/
fuzz-failures/
frontend/coverage/
build/appicon.png
build/bin/
frontend/src/wailsjs/
internal/webui/static/*
!internal/webui/static/robots.txt
*.log
*.local
.envrc
.direnv/
# Playwright test run artifacts (screenshots, traces, error context).
frontend/test-results/
frontend/playwright-report/
# `pnpm perf` builds (perf/dist, plus A/B baselines such as perf/dist-base).
frontend/perf/dist*/
# Local working notes — not part of the project history.
feedback.md
# graphify output (generated, not project history)
graphify-out/
# GitNexus index (generated, not project history)
.gitnexus/
# Tailscale TLS cert/key (generated by `tailscale cert`, must not be committed)
*.crt
*.key

# Local databases
*.db
*.db-wal
*.db-shm
*.db-journal

# Hugo site build output (site/)
site/public/
site/resources/
site/.hugo_build.lock
site/_vendor/
