{
  "$id": "https://ocman.dev/a2ui/results/v1/result.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type":"object",
  "additionalProperties":false,
  "required":["title","summary","messages"],
  "properties": {
    "title":{"type":"string","minLength":1,"maxLength":200},
    "summary":{"type":"string","minLength":1,"maxLength":2000},
    "messages":{"type":"array","minItems":2,"maxItems":32,"items":{"$ref":"#/$defs/message"}}
  },
  "$defs": {
    "message": {
      "type":"object","required":["version"],"minProperties":2,"maxProperties":2,"additionalProperties":false,
      "properties": {
        "version":{"const":"v0.9.1"},
        "createSurface":{"type":"object","required":["surfaceId","catalogId"],"additionalProperties":false,"properties":{"surfaceId":{"$ref":"common_types.json#/$defs/ComponentId"},"catalogId":{"const":"https://ocman.dev/a2ui/results/v1/catalog.json"}}},
        "updateComponents":{"type":"object","required":["surfaceId","components"],"additionalProperties":false,"properties":{"surfaceId":{"$ref":"common_types.json#/$defs/ComponentId"},"components":{"type":"array","minItems":1,"maxItems":100,"items":{"$ref":"catalog.json#/$defs/anyComponent"}}}},
        "updateDataModel":{"type":"object","required":["surfaceId","value"],"additionalProperties":false,"properties":{"surfaceId":{"$ref":"common_types.json#/$defs/ComponentId"},"path":{"const":"/"},"value":{"type":"object","maxProperties":100,"propertyNames":{"pattern":"^[A-Za-z][A-Za-z0-9_]{0,63}$","not":{"enum":["__proto__","constructor","prototype"]}},"additionalProperties":{"$ref":"common_types.json#/$defs/Scalar"}}}}
      }
    }
  }
}
