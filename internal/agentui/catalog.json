{
  "$id": "https://ocman.dev/a2ui/results/v1/catalog.json",
  "catalogId": "https://ocman.dev/a2ui/results/v1/catalog.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$defs": {
    "anyComponent": {
      "oneOf": [
        {"type":"object","required":["id","component","text"],"additionalProperties":false,"properties":{"id":{"$ref":"common_types.json#/$defs/ComponentId"},"component":{"const":"Text"},"text":{"$ref":"common_types.json#/$defs/String"},"variant":{"enum":["body","h2","h3","caption"]}}},
        {"type":"object","required":["id","component","children"],"additionalProperties":false,"properties":{"id":{"$ref":"common_types.json#/$defs/ComponentId"},"component":{"enum":["Column","Row"]},"children":{"$ref":"common_types.json#/$defs/ChildList"}}},
        {"type":"object","required":["id","component","child"],"additionalProperties":false,"properties":{"id":{"$ref":"common_types.json#/$defs/ComponentId"},"component":{"const":"Card"},"child":{"$ref":"common_types.json#/$defs/ComponentId"}}},
        {"type":"object","required":["id","component"],"additionalProperties":false,"properties":{"id":{"$ref":"common_types.json#/$defs/ComponentId"},"component":{"const":"Divider"}}},
        {"type":"object","required":["id","component","label","value"],"additionalProperties":false,"properties":{"id":{"$ref":"common_types.json#/$defs/ComponentId"},"component":{"enum":["TextField","CheckBox"]},"label":{"type":"string","minLength":1,"maxLength":200},"value":{"$ref":"common_types.json#/$defs/Binding"}}},
        {"type":"object","required":["id","component","child","action"],"additionalProperties":false,"properties":{"id":{"$ref":"common_types.json#/$defs/ComponentId"},"component":{"const":"Button"},"child":{"$ref":"common_types.json#/$defs/ComponentId"},"action":{"type":"object","required":["event"],"additionalProperties":false,"properties":{"event":{"type":"object","required":["name"],"additionalProperties":false,"properties":{"name":{"type":"string","pattern":"^[A-Za-z][A-Za-z0-9_-]{0,63}$"},"context":{"type":"object","maxProperties":32,"propertyNames":{"pattern":"^[A-Za-z][A-Za-z0-9_]{0,63}$","not":{"enum":["__proto__","constructor","prototype"]}},"additionalProperties":{"anyOf":[{"$ref":"common_types.json#/$defs/Scalar"},{"$ref":"common_types.json#/$defs/Binding"}]}}}}}}}},
        {"type":"object","required":["id","component","columns","rows"],"additionalProperties":false,"properties":{"id":{"$ref":"common_types.json#/$defs/ComponentId"},"component":{"const":"Table"},"columns":{"type":"array","minItems":1,"maxItems":12,"items":{"type":"string","minLength":1,"maxLength":200}},"rows":{"type":"array","maxItems":200,"items":{"type":"array","maxItems":12,"items":{"$ref":"common_types.json#/$defs/Scalar"}}}}},
        {"type":"object","required":["id","component","label","data"],"additionalProperties":false,"properties":{"id":{"$ref":"common_types.json#/$defs/ComponentId"},"component":{"const":"BarChart"},"label":{"type":"string","minLength":1,"maxLength":200},"unit":{"$ref":"common_types.json#/$defs/Unit"},"format":{"$ref":"common_types.json#/$defs/ValueFormat"},"data":{"type":"array","maxItems":50,"items":{"type":"object","required":["label","value"],"additionalProperties":false,"properties":{"label":{"type":"string","maxLength":200},"value":{"type":"number","minimum":0,"maximum":1000000000000}}}}}},
        {"type":"object","required":["id","component","label","data"],"additionalProperties":false,"properties":{"id":{"$ref":"common_types.json#/$defs/ComponentId"},"component":{"const":"PieChart"},"label":{"$ref":"common_types.json#/$defs/ChartLabel"},"variant":{"enum":["donut","pie"]},"unit":{"$ref":"common_types.json#/$defs/Unit"},"format":{"$ref":"common_types.json#/$defs/ValueFormat"},"data":{"type":"array","minItems":1,"maxItems":50,"items":{"type":"object","required":["label","value"],"additionalProperties":false,"properties":{"label":{"$ref":"common_types.json#/$defs/SeriesName"},"value":{"$ref":"common_types.json#/$defs/NonNegative"}}}}}},
        {"type":"object","required":["id","component","label","categories","series"],"additionalProperties":false,"properties":{"id":{"$ref":"common_types.json#/$defs/ComponentId"},"component":{"const":"MultiBarChart"},"label":{"$ref":"common_types.json#/$defs/ChartLabel"},"mode":{"enum":["grouped","stacked"]},"orientation":{"enum":["vertical","horizontal"]},"xLabel":{"$ref":"common_types.json#/$defs/AxisLabel"},"yLabel":{"$ref":"common_types.json#/$defs/AxisLabel"},"unit":{"$ref":"common_types.json#/$defs/Unit"},"format":{"$ref":"common_types.json#/$defs/ValueFormat"},"categories":{"type":"array","minItems":1,"maxItems":50,"uniqueItems":true,"items":{"$ref":"common_types.json#/$defs/SeriesName"}},"series":{"type":"array","minItems":1,"maxItems":8,"items":{"type":"object","required":["name","values"],"additionalProperties":false,"properties":{"name":{"$ref":"common_types.json#/$defs/SeriesName"},"values":{"type":"array","maxItems":50,"items":{"anyOf":[{"$ref":"common_types.json#/$defs/NonNegative"},{"type":"null"}]}}}}}}},
        {"type":"object","required":["id","component","label","x","series"],"additionalProperties":false,"properties":{"id":{"$ref":"common_types.json#/$defs/ComponentId"},"component":{"const":"LineChart"},"label":{"$ref":"common_types.json#/$defs/ChartLabel"},"area":{"type":"boolean"},"xLabel":{"$ref":"common_types.json#/$defs/AxisLabel"},"yLabel":{"$ref":"common_types.json#/$defs/AxisLabel"},"unit":{"$ref":"common_types.json#/$defs/Unit"},"format":{"$ref":"common_types.json#/$defs/ValueFormat"},"x":{"oneOf":[
          {"type":"object","required":["type","values"],"additionalProperties":false,"properties":{"type":{"const":"category"},"values":{"type":"array","minItems":2,"maxItems":366,"uniqueItems":true,"items":{"$ref":"common_types.json#/$defs/SeriesName"}}}},
          {"type":"object","required":["type","values"],"additionalProperties":false,"properties":{"type":{"const":"number"},"values":{"type":"array","minItems":2,"maxItems":366,"items":{"$ref":"common_types.json#/$defs/ChartNumber"}}}},
          {"type":"object","required":["type","values"],"additionalProperties":false,"properties":{"type":{"const":"date"},"values":{"type":"array","minItems":2,"maxItems":366,"items":{"$ref":"common_types.json#/$defs/IsoDate"}}}}
        ]},"series":{"type":"array","minItems":1,"maxItems":8,"items":{"type":"object","required":["name","values"],"additionalProperties":false,"properties":{"name":{"$ref":"common_types.json#/$defs/SeriesName"},"values":{"type":"array","maxItems":366,"items":{"anyOf":[{"$ref":"common_types.json#/$defs/ChartNumber"},{"type":"null"}]}}}}}}},
        {"type":"object","required":["id","component","label","series"],"additionalProperties":false,"properties":{"id":{"$ref":"common_types.json#/$defs/ComponentId"},"component":{"const":"ScatterChart"},"label":{"$ref":"common_types.json#/$defs/ChartLabel"},"xLabel":{"$ref":"common_types.json#/$defs/AxisLabel"},"yLabel":{"$ref":"common_types.json#/$defs/AxisLabel"},"xUnit":{"$ref":"common_types.json#/$defs/Unit"},"unit":{"$ref":"common_types.json#/$defs/Unit"},"format":{"$ref":"common_types.json#/$defs/ValueFormat"},"series":{"type":"array","minItems":1,"maxItems":3,"items":{"type":"object","required":["name","points"],"additionalProperties":false,"properties":{"name":{"$ref":"common_types.json#/$defs/SeriesName"},"points":{"type":"array","minItems":1,"maxItems":200,"items":{"type":"array","minItems":2,"maxItems":2,"items":{"$ref":"common_types.json#/$defs/ChartNumber"}}}}}}}},
        {"type":"object","required":["id","component","label","value"],"additionalProperties":false,"properties":{"id":{"$ref":"common_types.json#/$defs/ComponentId"},"component":{"const":"Stat"},"label":{"$ref":"common_types.json#/$defs/ChartLabel"},"value":{"$ref":"common_types.json#/$defs/ChartNumber"},"unit":{"$ref":"common_types.json#/$defs/Unit"},"format":{"$ref":"common_types.json#/$defs/ValueFormat"},"delta":{"$ref":"common_types.json#/$defs/ChartNumber"},"deltaLabel":{"type":"string","minLength":1,"maxLength":60},"better":{"enum":["up","down","neither"]}}}
      ]
    }
  }
}
