{
  "$id": "https://ocman.dev/a2ui/results/v1/common_types.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$defs": {
    "ComponentId": {"type":"string","pattern":"^[A-Za-z][A-Za-z0-9_-]{0,63}$"},
    "ChildList": {"type":"array","maxItems":100,"uniqueItems":true,"items":{"$ref":"#/$defs/ComponentId"}},
    "Binding": {"type":"object","required":["path"],"additionalProperties":false,"properties":{"path":{"type":"string","pattern":"^/[A-Za-z][A-Za-z0-9_]{0,63}$","not":{"enum":["/__proto__","/constructor","/prototype"]}}}},
    "String": {"anyOf":[{"type":"string","maxLength":8000},{"$ref":"#/$defs/Binding"}]},
    "Scalar": {"type":["string","number","boolean","null"],"maxLength":8000},
    "ChartLabel": {"type":"string","minLength":1,"maxLength":200},
    "AxisLabel": {"type":"string","minLength":1,"maxLength":80},
    "SeriesName": {"type":"string","minLength":1,"maxLength":80},
    "Unit": {"type":"string","pattern":"^[^\\r\\n]{1,16}$"},
    "ValueFormat": {"enum":["number","compact","percent","bytes"]},
    "NonNegative": {"type":"number","minimum":0,"maximum":1000000000000},
    "ChartNumber": {"type":"number","minimum":-1000000000000,"maximum":1000000000000},
    "IsoDate": {"type":"string","pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}(T[0-9]{2}:[0-9]{2}(:[0-9]{2}(\\.[0-9]{1,3})?)?(Z|[+-]([01][0-9]|2[0-3]):[0-5][0-9])?)?$"}
  }
}
